<Window x:Class="DocuArchivePro.Views.AttachmentViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[ViewerWindowTitle]}"
        Height="800" Width="1050"
        MinHeight="550" MinWidth="740"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/Icons/AppIcon.png"
        ResizeMode="CanResizeWithGrip"
        Background="#0F172A"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Security Banner -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="18,14" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#059669" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Loc[ViewerEncryptedBadge]}" Foreground="White" FontSize="11.5" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="TxtFileName" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtFileMeta" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Viewer Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnRotate" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,6,0" Click="BtnRotate_Click" Visibility="Collapsed">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[ViewerRotateBtn]}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnZoomIn" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,6,0" Click="BtnZoomIn_Click">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[ZoomIn]}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnZoomOut" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,6,0" Click="BtnZoomOut_Click">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[ZoomOut]}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnZoomReset" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,6,0" Click="BtnZoomReset_Click">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[ViewerZoomReset]}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnSaveCopy" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,6,0" Click="BtnSaveCopy_Click">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[ViewerSaveCopyBtn]}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnOpenExternal" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,6,0" Click="BtnOpenExternal_Click">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[ViewerOpenExternalBtn]}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnPrintAttachment" Style="{StaticResource ModernPrimaryButton}" Click="BtnPrintAttachment_Click">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[ViewerPrintBtn]}"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Multi-Attachment Navigation Bar -->
                <Border x:Name="AttachmentNavBar" Visibility="Collapsed" Margin="0,12,0,0" Padding="10,8" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnPrevAttachment" Grid.Column="0" Style="{StaticResource ModernSecondaryButton}" MinHeight="32" Padding="12,4" Margin="0,0,10,0" Click="BtnPrevAttachment_Click">
                            <TextBlock Text="{Binding Loc[ViewerPrevAttachmentBtn]}" FontWeight="SemiBold" FontSize="12.5"/>
                        </Button>

                        <TextBlock x:Name="TxtAttachmentPosition" Grid.Column="1" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="4,0,12,0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Loc[ViewerAttachmentJumpLabel]}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbAttachmentSelector" DisplayMemberPath="FileName" MinWidth="220" MaxWidth="420" Height="32"
                                      Style="{StaticResource ModernComboBox}" SelectionChanged="CmbAttachmentSelector_SelectionChanged"/>
                        </StackPanel>

                        <Button x:Name="BtnNextAttachment" Grid.Column="3" Style="{StaticResource ModernSecondaryButton}" MinHeight="32" Padding="12,4" Margin="10,0,0,0" Click="BtnNextAttachment_Click">
                            <TextBlock Text="{Binding Loc[ViewerNextAttachmentBtn]}" FontWeight="SemiBold" FontSize="12.5"/>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Main Viewer Area -->
        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" Padding="12" ClipToBounds="True">
            <Grid>
                <!-- 1. Image Viewer (In-Memory Decrypted) -->
                <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                        <Border Background="White" Padding="8" Effect="{StaticResource CardShadow}">
                            <Image x:Name="ImgDecrypted" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.LayoutTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ImgScale" ScaleX="1.0" ScaleY="1.0"/>
                                        <RotateTransform x:Name="ImgRotate" Angle="0"/>
                                    </TransformGroup>
                                </Image.LayoutTransform>
                            </Image>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- 2. Text Content Viewer -->
                <TextBox x:Name="TxtDecryptedContent" IsReadOnly="True" Visibility="Collapsed"
                         FontFamily="Consolas, Segoe UI, Tahoma" FontSize="14" Padding="16"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="White" BorderThickness="0"/>

                <!-- 3. Document / PDF Embedded Preview Panel -->
                <Grid x:Name="DocPreviewPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ModernPrimaryButton}" Click="BtnOpenTempProtected_Click" MinWidth="170">
                                <Viewbox StretchDirection="DownOnly">
                                    <TextBlock Text="{Binding Loc[ViewerTempOpenBtn]}"/>
                                </Viewbox>
                            </Button>
                            <TextBlock Text="{Binding Loc[ViewerTempBannerDesc]}"
                                       Foreground="#1E3A8A" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                        </DockPanel>
                    </Border>
                    <WebBrowser x:Name="PdfWebBrowser" Grid.Row="1" Visibility="Collapsed"/>
                    <FlowDocumentScrollViewer x:Name="WordDocViewer" Grid.Row="1" Visibility="Collapsed"
                                              Background="White" Foreground="Black" IsToolBarVisible="True"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Loc[ViewerSecurityNote]}"
                       Foreground="#94A3B8" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" MinWidth="150" Style="{StaticResource ModernSecondaryButton}" Click="BtnClose_Click">
                <Viewbox StretchDirection="DownOnly">
                    <TextBlock Text="{Binding Loc[ViewerCloseBtn]}"/>
                </Viewbox>
            </Button>
        </Grid>
    </Grid>
</Window>