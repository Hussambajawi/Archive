<Window x:Class="DocuArchivePro.Views.UserLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[UserMgmtWindowTitle]}"
        Height="820" Width="1220"
        MinHeight="620" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Icons/SecurityLockIcon.png"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP BRANDING & LIVE DATE/TIME BAR ================= -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="14" Padding="22,16" Margin="0,0,0,18" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="52" Height="52" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="12" Margin="0,0,14,0">
                        <Image Source="{StaticResource SecurityLockImage}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[AppTitle]}" FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Loc[UserMgmtSubheader]}" FontSize="13" Foreground="#94A3B8" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Live Clock & Dual Calendar Pill -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="16,10" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderDayAndTime" Foreground="#38BDF8" FontWeight="Bold" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="TxtHeaderGregorian" Foreground="#E2E8F0" FontSize="12" Margin="0,0,12,0"/>
                                <TextBlock Text="|" Foreground="#475569" Margin="0,0,12,0"/>
                                <TextBlock x:Name="TxtHeaderHijri" Foreground="#34D399" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN BODY (2 COLUMNS) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. USER SELECTION & LOGIN PANEL -->
            <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="24" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="{Binding Loc[UserMgmtSelectLoginTitle]}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Loc[UserMgmtSelectLoginDesc]}"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Users Table -->
                    <DataGrid x:Name="DgUsers" Grid.Row="1" Style="{StaticResource ModernDataGrid}"
                              SelectionChanged="DgUsers_SelectionChanged" Margin="0,0,0,16">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="1.2*">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataContext.Loc[ColUsername], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LocalizedUsername}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="1.1*">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataContext.Loc[ColRoleTitle], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LocalizedRoleTitle}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="1.6*">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataContext.Loc[ColPermissions], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PermissionsSummary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Selected User Login Box -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Loc[UserMgmtSelectedUserLabel]}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <ComboBox x:Name="CmbLoginUser" DisplayMemberPath="LocalizedUsername" Style="{StaticResource ModernComboBox}"
                                              SelectionChanged="CmbLoginUser_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Loc[UserMgmtUserPasswordLabel]}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <PasswordBox x:Name="PwdLoginPassword" Height="38" Padding="10,6" VerticalContentAlignment="Center"
                                                 BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                                <TextBlock x:Name="TxtSelectedUserPermissions"
                                           Foreground="#1E40AF" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>

                            <Button Style="{StaticResource ModernPrimaryButton}" Height="46" FontSize="15" Click="BtnLogin_Click">
                                <Viewbox StretchDirection="DownOnly">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource SecurityLockImage}" Width="20" Height="20" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Loc[UserMgmtLoginWithSelectedBtn]}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. USER MANAGEMENT & ACTION SECURITY PIN SETUP PANEL -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="AdminOnlyBanner" Grid.Row="0" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1.5" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Loc[UserMgmtAdminOnlyBanner]}" Foreground="#991B1B" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                </Border>

                <ScrollViewer x:Name="AdminManagementPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Card A: Add / Edit User & Permissions -->
                    <Border Background="White" CornerRadius="14" Padding="22" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[UserMgmtFormTitle]}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Loc[UserMgmtUsernameField]}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtEditUsername" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Loc[UserMgmtRoleField]}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtEditRole" Style="{StaticResource ModernTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Loc[UserMgmtPasswordField]}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <PasswordBox x:Name="PwdEditLoginPassword" Height="38" Padding="10,6" VerticalContentAlignment="Center"
                                             BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1"/>
                                <TextBlock Text="{Binding Loc[UserMgmtKeepPasswordHint]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <CheckBox x:Name="ChkClearLoginPassword"
                                          Content="إلغاء كلمة المرور للمستخدم المحدد (تسجيل دخول بدون كلمة سر) / Clear User Password"
                                          FontSize="11.5" Foreground="#B45309" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Granular Permissions Checkboxes -->
                            <TextBlock Text="{Binding Loc[UserMgmtPermissionsLabel]}" FontWeight="Bold" FontSize="13.5" Margin="0,4,0,8" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Border Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkIsAdmin" Content="{Binding Loc[PermIsAdmin]}"
                                              FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"
                                              Checked="ChkIsAdmin_Changed" Unchecked="ChkIsAdmin_Changed"/>

                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="ChkCanAdd" Content="{Binding Loc[PermCanAdd]}" Margin="0,4" IsChecked="True"/>
                                        <CheckBox x:Name="ChkCanEdit" Content="{Binding Loc[PermCanEdit]}" Margin="0,4"/>
                                        <CheckBox x:Name="ChkCanDelete" Content="{Binding Loc[PermCanDelete]}" Margin="0,4"/>
                                        <CheckBox x:Name="ChkCanScan" Content="{Binding Loc[PermCanScan]}" Margin="0,4" IsChecked="True"/>
                                        <CheckBox x:Name="ChkCanPrint" Content="{Binding Loc[PermCanPrint]}" Margin="0,4" IsChecked="True"/>
                                        <CheckBox x:Name="ChkCanManageStorage" Content="{Binding Loc[PermCanManageStorage]}" Margin="0,4"/>
                                        <CheckBox x:Name="ChkCanManageEntities" Content="{Binding Loc[PermCanManageEntities]}" Margin="0,4"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- User CRUD Action Buttons -->
                            <UniformGrid Rows="1">
                                <Button Style="{StaticResource ModernPrimaryButton}" Margin="0,0,6,0" HorizontalAlignment="Stretch" Click="BtnAddNewUser_Click">
                                    <Viewbox StretchDirection="DownOnly">
                                        <TextBlock Text="{Binding Loc[BtnAddNewUser]}"/>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource ModernSecondaryButton}" Margin="3,0" HorizontalAlignment="Stretch" Click="BtnUpdateSelectedUser_Click">
                                    <Viewbox StretchDirection="DownOnly">
                                        <TextBlock Text="{Binding Loc[BtnUpdateUser]}"/>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource ModernSecondaryButton}" Foreground="#DC2626" Margin="6,0,0,0" HorizontalAlignment="Stretch" Click="BtnDeleteSelectedUser_Click">
                                    <Viewbox StretchDirection="DownOnly">
                                        <TextBlock Text="{Binding Loc[BtnDeleteUser]}"/>
                                    </Viewbox>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Card B: Pre-configured Security Action Code (for Delete / Edit / Add Dossier confirmations) -->
                    <Border Background="White" CornerRadius="14" Padding="22" Margin="0,0,0,16" Effect="{StaticResource CardShadow}" BorderBrush="#F59E0B" BorderThickness="1.5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Image Source="{StaticResource SecurityLockImage}" Width="24" Height="24" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Loc[ActionPinSetupTitle]}" FontSize="16" FontWeight="Bold" Foreground="#B45309" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding Loc[ActionPinSetupDesc]}"
                                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="PwdActionSecurityCode" Height="40" Padding="10,6" VerticalContentAlignment="Center"
                                             BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5" FontSize="15"/>
                                <Button Grid.Column="2" Style="{StaticResource ModernPrimaryButton}" MinWidth="130" Click="BtnSaveActionCode_Click">
                                    <Viewbox StretchDirection="DownOnly">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource SecurityLockImage}" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Loc[BtnSaveActionCode]}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card C: Pre-configured Security Password Specific to Adding Inbound / Outbound Entities -->
                    <Border Background="White" CornerRadius="14" Padding="22" Effect="{StaticResource CardShadow}" BorderBrush="#0D9488" BorderThickness="1.5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Image Source="{StaticResource SecurityLockImage}" Width="24" Height="24" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Loc[EntityPinSetupTitle]}" FontSize="16" FontWeight="Bold" Foreground="#0F766E" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding Loc[EntityPinSetupDesc]}"
                                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="PwdEntitySecurityCode" Height="40" Padding="10,6" VerticalContentAlignment="Center"
                                             BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5" FontSize="15"/>
                                <Button Grid.Column="2" Style="{StaticResource ModernPrimaryButton}" MinWidth="130" Click="BtnSaveEntityCode_Click">
                                    <Viewbox StretchDirection="DownOnly">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource SecurityLockImage}" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Loc[BtnSaveEntityCode]}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Loc[CopyrightFooter]}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Button Grid.Column="1" MinWidth="130" Style="{StaticResource ModernSecondaryButton}" Click="BtnCancel_Click">
                <Viewbox StretchDirection="DownOnly">
                    <TextBlock Text="{Binding Loc[BtnCloseExit]}"/>
                </Viewbox>
            </Button>
        </Grid>
    </Grid>
</Window>