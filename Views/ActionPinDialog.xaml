<Window x:Class="DocuArchivePro.Views.ActionPinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[ActionPinWindowTitle]}"
        SizeToContent="Height"
        MinHeight="340" Width="520" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/Icons/SecurityLockIcon.png"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid Margin="22">
        <Border Background="White" CornerRadius="12" Padding="24" Effect="{StaticResource CardShadow}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Image Source="{StaticResource SecurityLockImage}" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeader" Text="{Binding Loc[ActionPinHeader]}" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtActionDescription" Text="{Binding Loc[ActionPinDefaultDesc]}" FontSize="12.5" Foreground="#DC2626" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="TxtPrompt" Text="{Binding Loc[ActionPinPrompt]}"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>

                <PasswordBox x:Name="PwdActionCode" Height="40" FontSize="16" Padding="10,6"
                             BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5"
                             VerticalContentAlignment="Center" KeyDown="PwdActionCode_KeyDown"/>

                <TextBlock x:Name="TxtError" Text="{Binding Loc[ActionPinError]}"
                           Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                <UniformGrid Rows="1" Columns="2" Margin="0,20,0,0">
                    <Button Style="{StaticResource ModernPrimaryButton}" MinWidth="140" MinHeight="40" Margin="0,0,6,0" Click="BtnConfirm_Click">
                        <Viewbox StretchDirection="DownOnly">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource SecurityLockImage}" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Loc[ActionPinConfirmBtn]}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ModernSecondaryButton}" MinWidth="120" MinHeight="40" Margin="6,0,0,0" Click="BtnCancel_Click">
                        <Viewbox StretchDirection="DownOnly">
                            <TextBlock Text="{Binding Loc[Cancel]}"/>
                        </Viewbox>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>