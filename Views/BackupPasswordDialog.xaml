<Window x:Class="DocuArchivePro.Views.BackupPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        SizeToContent="Height"
        MinHeight="280" Width="520" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/Icons/SecurityLockIcon.png"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid Margin="22">
        <Border Background="White" CornerRadius="12" Padding="24" Effect="{StaticResource CardShadow}">
            <StackPanel>
                <!-- Header with Icon -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Image Source="{StaticResource SecurityLockImage}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeader" Text="{Binding HeaderText}" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtSubHeader" Text="{Binding SubHeaderText}" FontSize="12.5" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="TxtPrompt" Text="{Binding PromptText}"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="19"/>

                <!-- Set Password Panel -->
                <StackPanel x:Name="PnlSetPassword" Visibility="Collapsed">
                    <TextBlock Text="كلمة المرور / Password:" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PwdSetPassword" Height="40" FontSize="15" Padding="10,6"
                                 BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="تأكيد كلمة المرور / Confirm Password:" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PwdConfirmPassword" Height="40" FontSize="15" Padding="10,6"
                                 BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5"
                                 VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <CheckBox x:Name="ChkNoPassword" Content="تخطي كلمة المرور المخصصة (الاعتماد على التشفير التلقائي بمفتاح النظام)"
                              FontWeight="Normal" FontSize="12" Margin="0,0,0,6" Checked="ChkNoPassword_CheckedChanged" Unchecked="ChkNoPassword_CheckedChanged"/>
                </StackPanel>

                <!-- Enter Password Panel -->
                <StackPanel x:Name="PnlEnterPassword" Visibility="Collapsed">
                    <TextBlock Text="أدخل كلمة المرور / Enter Password:" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PwdEnterPassword" Height="40" FontSize="16" Padding="10,6"
                                 BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5"
                                 VerticalContentAlignment="Center" KeyDown="PwdEnterPassword_KeyDown"/>
                </StackPanel>

                <!-- Error Message -->
                <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                <!-- Action Buttons -->
                <UniformGrid Rows="1" Columns="2" Margin="0,20,0,0">
                    <Button Style="{StaticResource ModernPrimaryButton}" MinWidth="140" MinHeight="42" Margin="0,0,6,0" Click="BtnConfirm_Click">
                        <Viewbox StretchDirection="DownOnly">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource SecurityLockImage}" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding ConfirmButtonText}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ModernSecondaryButton}" MinWidth="120" MinHeight="42" Margin="6,0,0,0" Click="BtnCancel_Click">
                        <Viewbox StretchDirection="DownOnly">
                            <TextBlock Text="{Binding Loc[Cancel]}"/>
                        </Viewbox>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
