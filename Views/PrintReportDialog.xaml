<Window x:Class="DocuArchivePro.Views.PrintReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[PrintWindowTitle]}"
        Height="820" Width="1150"
        MinHeight="580" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/Icons/AppIcon.png"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="12" Padding="20,14" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Loc[PrintHeaderTitle]}"
                               FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Loc[PrintHeaderSubtitle]}"
                               FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <UniformGrid Grid.Column="1" Rows="1" Columns="4" VerticalAlignment="Center" MinWidth="660">
                    <Button x:Name="BtnPrintBarcodeSticker" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,8,0" MinHeight="42" Click="BtnPrintBarcodeSticker_Click">
                        <Viewbox StretchDirection="DownOnly">
                            <TextBlock Text="{Binding Loc[PrintBarcodeStickerBtn]}"/>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ModernSecondaryButton}" Margin="0,0,8,0" MinHeight="42" Click="BtnExportCsv_Click">
                        <Viewbox StretchDirection="DownOnly">
                            <TextBlock Text="{Binding Loc[PrintExportCsvBtn]}"/>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ModernSecondaryButton}" Margin="0,0,8,0" MinHeight="42" Click="BtnExportPdf_Click">
                        <Viewbox StretchDirection="DownOnly">
                            <TextBlock Text="{Binding Loc[PrintExportPdfBtn]}"/>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ModernPrimaryButton}" MinHeight="42" Click="BtnPrintNow_Click">
                        <Viewbox StretchDirection="DownOnly">
                            <TextBlock Text="{Binding Loc[PrintNowBtn]}"/>
                        </Viewbox>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Report Options & Filters Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,18,2">
                    <TextBlock Text="{Binding Loc[PrintReportTypeLabel]}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbReportType" MinWidth="280" Style="{StaticResource ModernComboBox}" SelectionChanged="FilterOption_Changed">
                        <ComboBoxItem Content="{Binding Loc[PrintReportType1]}"/>
                        <ComboBoxItem Content="{Binding Loc[PrintReportType2]}"/>
                        <ComboBoxItem Content="{Binding Loc[PrintReportType3]}"/>
                        <ComboBoxItem Content="{Binding Loc[PrintReportType4]}"/>
                        <ComboBoxItem Content="{Binding Loc[PrintReportType5]}"/>
                        <ComboBoxItem Content="{Binding Loc[PrintReportType6]}"/>
                        <ComboBoxItem Content="{Binding Loc[PrintReportType7]}"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBlock Text="{Binding Loc[PrintFromDateLabel]}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpFrom" Width="130" SelectedDateChanged="FilterOption_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBlock Text="{Binding Loc[PrintToDateLabel]}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpTo" Width="130" SelectedDateChanged="FilterOption_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBlock Text="{Binding Loc[Category]}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbFilterCategory" MinWidth="190" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                              Style="{StaticResource ModernComboBox}" SelectionChanged="FilterOption_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBox x:Name="TxtReportSearch" Width="180" Style="{StaticResource ModernTextBox}" Height="34"
                             VerticalContentAlignment="Center" TextChanged="TxtReportSearch_TextChanged"
                             ToolTip="تصفية حسب الجهة أو الموضوع أو رقم القيد / Filter by entity, subject, or reg no."/>
                </StackPanel>

                <StackPanel x:Name="PanelStickerSize" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBlock Text="{Binding Loc[StickerSizeLabel]}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbStickerSize" MinWidth="220" Style="{StaticResource ModernComboBox}" SelectionChanged="FilterOption_Changed" SelectedIndex="0">
                        <ComboBoxItem Content="{Binding Loc[StickerSizeStandard]}"/>
                        <ComboBoxItem Content="{Binding Loc[StickerSizeThermalSmall]}"/>
                        <ComboBoxItem Content="{Binding Loc[StickerSizeThermalMedium]}"/>
                    </ComboBox>
                </StackPanel>

                <Button Style="{StaticResource ModernSecondaryButton}" Click="BtnRefreshPreview_Click" Margin="0,2">
                    <Viewbox StretchDirection="DownOnly">
                        <TextBlock Text="{Binding Loc[PrintRefreshPreviewBtn]}"/>
                    </Viewbox>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Live Print Preview Area -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="10" Effect="{StaticResource CardShadow}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
            <FlowDocumentScrollViewer x:Name="DocViewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="True"/>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TxtSummaryFooter" Text="{Binding Loc[PrintReadyFooter]}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Button Grid.Column="1" MinWidth="150" Style="{StaticResource ModernSecondaryButton}" Click="BtnClose_Click">
                <Viewbox StretchDirection="DownOnly">
                    <TextBlock Text="{Binding Loc[PrintCloseBtn]}"/>
                </Viewbox>
            </Button>
        </Grid>
    </Grid>
</Window>