<Window x:Class="DocuArchivePro.Views.DeleteCategoryWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[WizDeleteCatWindowTitle]}"
        Width="700" MinWidth="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/Icons/SecurityLockIcon.png"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="14" Padding="24" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Wizard Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FEE2E2" CornerRadius="10" Width="48" Height="48" VerticalAlignment="Top">
                        <Image Source="{StaticResource SecurityLockImage}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[WizDeleteCatHeader]}" FontSize="17.5" FontWeight="Bold" Foreground="#991B1B" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Loc[WizDeleteCatSubheader]}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- 3-Step Visual Progress Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="StepBadge1" Grid.Column="0" Background="#EFF6FF" BorderBrush="#2563EB" BorderThickness="1.5" CornerRadius="8" Padding="10,8">
                        <TextBlock x:Name="TxtBadge1" Text="{Binding Loc[WizStep1Badge]}" FontWeight="Bold" FontSize="12" Foreground="#1E40AF" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                    <Border x:Name="StepBadge2" Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="10,8">
                        <TextBlock x:Name="TxtBadge2" Text="{Binding Loc[WizStep2Badge]}" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                    <Border x:Name="StepBadge3" Grid.Column="4" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="8" Padding="10,8">
                        <TextBlock x:Name="TxtBadge3" Text="{Binding Loc[WizStep3Badge]}" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- STEP 1: Warning & Live Database Impact -->
                <StackPanel x:Name="PanelStep1" Grid.Row="2" Visibility="Visible">
                    <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[WizStep1WarningTitle]}" FontSize="14.5" FontWeight="Bold" Foreground="#B91C1C" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtStep1ImpactMessage" FontSize="13.5" FontWeight="SemiBold" Foreground="#7F1D1D" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Loc[WizStep1WarningSub]}" FontSize="12" Foreground="#991B1B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 3 Live Database Count Cards -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtInboundCountVal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Loc[WizInboundCountLabel]}" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtOutboundCountVal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#C2410C" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Loc[WizOutboundCountLabel]}" FontSize="12" FontWeight="SemiBold" Foreground="#9A3412" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtAttachmentsCountVal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#6D28D9" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Loc[WizAttachmentsCountLabel]}" FontSize="12" FontWeight="SemiBold" Foreground="#5B21B6" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Step 1 Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="BtnStep1Next_Click" Style="{StaticResource ModernPrimaryButton}" MinHeight="42">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[WizStep1NextBtn]}"/>
                            </Viewbox>
                        </Button>
                        <Button Grid.Column="2" Click="BtnCancel_Click" Style="{StaticResource ModernSecondaryButton}" IsCancel="True" MinHeight="42">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[Cancel]}"/>
                            </Viewbox>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- STEP 2: Optional Unencrypted Backup for Future Import -->
                <StackPanel x:Name="PanelStep2" Grid.Row="2" Visibility="Collapsed">
                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[WizStep2QuestionTitle]}" FontSize="14.5" FontWeight="Bold" Foreground="#166534" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Loc[WizStep2QuestionDesc]}" FontSize="12.5" Foreground="#14532D" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Loc[WizStep2SelectFolderLabel]}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtBackupFolder" Grid.Column="0" Style="{StaticResource ModernTextBox}" Height="40"/>
                        <Button Grid.Column="2" Click="BtnBrowseBackupFolder_Click" Style="{StaticResource ModernSecondaryButton}" MinWidth="135" MinHeight="40">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[WizStep2BrowseBtn]}"/>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <!-- Step 2 Action Buttons -->
                    <StackPanel Margin="0,0,0,10">
                        <Button x:Name="BtnCreateBackup" Click="BtnYesCreateBackup_Click" Style="{StaticResource ModernPrimaryButton}" Background="#15803D" MinHeight="44" Margin="0,0,0,10">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[WizStep2YesBackupBtn]}" FontWeight="Bold"/>
                            </Viewbox>
                        </Button>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="BtnSkipBackup_Click" Style="{StaticResource ModernSecondaryButton}" MinHeight="40" BorderBrush="#F59E0B" Foreground="#B45309">
                                <Viewbox StretchDirection="DownOnly">
                                    <TextBlock Text="{Binding Loc[WizStep2NoSkipBtn]}"/>
                                </Viewbox>
                            </Button>
                            <Button Grid.Column="2" Click="BtnBackToStep1_Click" Style="{StaticResource ModernSecondaryButton}" MinHeight="40">
                                <Viewbox StretchDirection="DownOnly">
                                    <TextBlock Text="{Binding Loc[WizBackBtn]}"/>
                                </Viewbox>
                            </Button>
                            <Button Grid.Column="4" Click="BtnCancel_Click" Style="{StaticResource ModernSecondaryButton}" MinHeight="40">
                                <Viewbox StretchDirection="DownOnly">
                                    <TextBlock Text="{Binding Loc[Cancel]}"/>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- STEP 3: Final Permanent Deletion or Safe Transfer Confirmation -->
                <StackPanel x:Name="PanelStep3" Grid.Row="2" Visibility="Collapsed">
                    <Border x:Name="BackupStatusBanner" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <TextBlock x:Name="TxtBackupStatusBanner" FontSize="12.5" FontWeight="SemiBold" Foreground="#166534" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Safe Option: Transfer Documents to Another Dossier & Delete Only the Category -->
                    <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="🔄 خيار آمن: نقل المعاملات إلى إضبارة بديلة وحذف هذه الإضبارة فقط (الحفاظ على جميع المعاملات والمرفقات)"
                                       FontSize="13.5" FontWeight="Bold" Foreground="#1E40AF" TextWrapping="Wrap"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbTransferTargetCategory" Grid.Column="0" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                          Style="{StaticResource ModernComboBox}" Height="38"/>
                                <Button x:Name="BtnTransferAndDelete" Grid.Column="2" Click="BtnTransferAndDelete_Click"
                                        Style="{StaticResource ModernPrimaryButton}" Background="#0284C7" MinHeight="38" Padding="14,6">
                                    <TextBlock Text="نقل المعاملات وحذف الإضبارة بأمان" FontWeight="Bold"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[WizStep3FinalTitle]}" FontSize="15" FontWeight="Bold" Foreground="#991B1B" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Loc[WizStep3FinalWarning]}" FontSize="12.5" Foreground="#7F1D1D" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtStep3FinalImpact" FontSize="12.5" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnFinalDelete" Grid.Column="0" Click="BtnDeletePermanently_Click" Style="{StaticResource ModernPrimaryButton}" Background="#DC2626" MinHeight="44">
                            <Viewbox StretchDirection="DownOnly">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{StaticResource SecurityLockImage}" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Loc[WizStep3DeletePermanentlyBtn]}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Viewbox>
                        </Button>
                        <Button Grid.Column="2" Click="BtnBackToStep2_Click" Style="{StaticResource ModernSecondaryButton}" MinHeight="44">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[WizBackBtn]}"/>
                            </Viewbox>
                        </Button>
                        <Button Grid.Column="4" Click="BtnCancel_Click" Style="{StaticResource ModernSecondaryButton}" MinHeight="44">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[Cancel]}"/>
                            </Viewbox>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
