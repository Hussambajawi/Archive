<Window x:Class="DocuArchivePro.Views.DateTimeCalendarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[CalendarWindowTitle]}"
        Height="640" Width="840"
        MinHeight="500" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/Icons/AppIcon.png"
        ResizeMode="CanResizeWithGrip"
        Background="#0F172A"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Digital Clock & Day Card -->
        <Border Grid.Row="0" CornerRadius="16" Padding="28,22" Margin="0,0,0,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E3A8A" Offset="0"/>
                    <GradientStop Color="#0F172A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#3B82F6" Opacity="0.4"/>
            </Border.BorderBrush>
            <Border.BorderThickness>1.5</Border.BorderThickness>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc[AppTitle]}" Foreground="#93C5FD" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtDayBanner" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,6,0,4"/>
                    <TextBlock Text="{Binding Loc[CalendarLiveSubtitle]}" Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#0F172A" CornerRadius="14" Padding="24,14" BorderBrush="#38BDF8" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[CalendarCurrentTimeLabel]}" Foreground="#38BDF8" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtLiveClock" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Dual Calendar Cards: Hijri & Gregorian -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Hijri Date Card -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="14" Padding="22" BorderBrush="#10B981" BorderThickness="1.5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="🌙" FontSize="20" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Loc[CalendarHijriTodayTitle]}" Foreground="#34D399" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtHijriFull" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,4,0,6" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtHijriNumeric" Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Gregorian Date Card -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="14" Padding="22" BorderBrush="#38BDF8" BorderThickness="1.5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="📅" FontSize="20" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Loc[CalendarGregorianTodayTitle]}" Foreground="#38BDF8" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtGregorianFull" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,4,0,6" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtGregorianNumeric" Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Interactive Date Picker & Converter for Archiving Reference -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="14" Padding="22" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding Loc[CalendarConverterTitle]}" Foreground="White" FontSize="15.5" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Loc[CalendarConverterDesc]}" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,14" TextWrapping="Wrap"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Loc[CalendarChooseDateLabel]}" Foreground="#CBD5E1" FontSize="13" Margin="0,0,0,6"/>
                        <DatePicker x:Name="DpConverter" SelectedDateChanged="DpConverter_SelectedDateChanged" Height="38" FontSize="14"/>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="10" Padding="16" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtConvertedResult" Foreground="#F8FAFC" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtConvertedSub" Foreground="#38BDF8" FontSize="13.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button MinWidth="140" Style="{StaticResource ModernSecondaryButton}" Click="BtnClose_Click">
                <Viewbox StretchDirection="DownOnly">
                    <TextBlock Text="{Binding Loc[CloseWindowBtn]}"/>
                </Viewbox>
            </Button>
        </StackPanel>
    </Grid>
</Window>