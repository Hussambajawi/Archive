<Window x:Class="DocuArchivePro.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[AboutWindowTitle]}"
        Height="720" Width="940"
        MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/Icons/AppIcon.png"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero Header -->
        <Border Grid.Row="0" CornerRadius="16" Padding="22,18" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E3A8A" Offset="0.6"/>
                    <GradientStop Color="#0E7490" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="64" Height="64" Background="#1E293B" BorderBrush="#93C5FD" BorderThickness="1.5" CornerRadius="14" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Image Source="{StaticResource AppLogoImage}" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc[AboutHeroTitle]}" FontSize="19" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Loc[AboutHeroSubtitle]}" FontSize="13" Foreground="#DBEAFE" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.2" CornerRadius="10" Padding="14,8" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Loc[AboutHeroBadge]}" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" TextAlignment="Center"/>
                        <TextBlock Text="{Binding Loc[Version]}" Foreground="#E2E8F0" FontSize="11.5" Margin="0,2,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Scrollable Body: Overview + Specs + What's New in 1.1 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- System Overview & Technical Badges -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[AboutApp]}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Loc[AboutAppDesc]}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="21"/>

                        <WrapPanel Margin="0,12,0,0">
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,6">
                                <TextBlock Text="{Binding Loc[AboutSpecsEncryption]}" Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,6">
                                <TextBlock Text="{Binding Loc[AboutSpecsDatabase]}" Foreground="#047857" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,6">
                                <TextBlock Text="{Binding Loc[AboutSpecsScanner]}" Foreground="#6D28D9" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,6">
                                <TextBlock Text="{Binding Loc[AboutSpecsLanguages]}" Foreground="#0369A1" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,6">
                                <TextBlock Text="{Binding Loc[AboutSpecsPlatform]}" Foreground="#B45309" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Version 1.1 Highlights Grid -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,16" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[AboutWhatsNewTitle]}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Loc[AboutWhatsNewSubtitle]}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,12" TextWrapping="Wrap"/>

                        <UniformGrid Columns="2">
                            <!-- Card 1 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="12" Padding="14" Margin="5">
                                <StackPanel>
                                    <Border Background="#DBEAFE" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Loc[AboutUpdate1Badge]}" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11.5"/>
                                    </Border>
                                    <TextBlock Text="{Binding Loc[AboutUpdate1Title]}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Loc[AboutUpdate1Desc]}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="12" Padding="14" Margin="5">
                                <StackPanel>
                                    <Border Background="#FEF3C7" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Loc[AboutUpdate2Badge]}" Foreground="#B45309" FontWeight="Bold" FontSize="11.5"/>
                                    </Border>
                                    <TextBlock Text="{Binding Loc[AboutUpdate2Title]}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Loc[AboutUpdate2Desc]}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="12" Padding="14" Margin="5">
                                <StackPanel>
                                    <Border Background="#FEF2F2" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Loc[AboutUpdate3Badge]}" Foreground="#DC2626" FontWeight="Bold" FontSize="11.5"/>
                                    </Border>
                                    <TextBlock Text="{Binding Loc[AboutUpdate3Title]}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Loc[AboutUpdate3Desc]}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="12" Padding="14" Margin="5">
                                <StackPanel>
                                    <Border Background="#EDE9FE" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Loc[AboutUpdate4Badge]}" Foreground="#6D28D9" FontWeight="Bold" FontSize="11.5"/>
                                    </Border>
                                    <TextBlock Text="{Binding Loc[AboutUpdate4Title]}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Loc[AboutUpdate4Desc]}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 5 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="12" Padding="14" Margin="5">
                                <StackPanel>
                                    <Border Background="#D1FAE5" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Loc[AboutUpdate5Badge]}" Foreground="#047857" FontWeight="Bold" FontSize="11.5"/>
                                    </Border>
                                    <TextBlock Text="{Binding Loc[AboutUpdate5Title]}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Loc[AboutUpdate5Desc]}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 6 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="12" Padding="14" Margin="5">
                                <StackPanel>
                                    <Border Background="#FCE7F3" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Loc[AboutUpdate6Badge]}" Foreground="#BE185D" FontWeight="Bold" FontSize="11.5"/>
                                    </Border>
                                    <TextBlock Text="{Binding Loc[AboutUpdate6Title]}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Loc[AboutUpdate6Desc]}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 7 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="12" Padding="14" Margin="5">
                                <StackPanel>
                                    <Border Background="#E0F2FE" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Loc[AboutUpdate7Badge]}" Foreground="#0369A1" FontWeight="Bold" FontSize="11.5"/>
                                    </Border>
                                    <TextBlock Text="{Binding Loc[AboutUpdate7Title]}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Loc[AboutUpdate7Desc]}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 8 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.2" CornerRadius="12" Padding="14" Margin="5">
                                <StackPanel>
                                    <Border Background="#DCFCE7" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Loc[AboutUpdate8Badge]}" Foreground="#15803D" FontWeight="Bold" FontSize="11.5"/>
                                    </Border>
                                    <TextBlock Text="{Binding Loc[AboutUpdate8Title]}" FontWeight="Bold" FontSize="14" Foreground="#0F172A" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Loc[AboutUpdate8Desc]}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,14,0,0" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Loc[CopyrightFooter]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>

                <Button Grid.Column="1" Click="BtnClose_Click" Style="{StaticResource ModernPrimaryButton}" MinWidth="140" MinHeight="38" Padding="18,6" Content="{Binding Loc[CloseWindowBtn]}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
