<Window x:Class="DocuArchivePro.Views.LoginPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[LoginPromptWindowTitle]}"
        SizeToContent="Height"
        MinHeight="480" Width="580" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/Icons/SecurityLockIcon.png"
        ResizeMode="CanResizeWithGrip"
        Background="#0F172A"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{DynamicResource AppFontFamily}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Margin="22">
        <Border Background="White" CornerRadius="16" Padding="28" Effect="{StaticResource PopupShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Border Width="62" Height="62" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Image Source="{StaticResource SecurityLockImage}" Width="50" Height="50" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Loc[LoginPromptHeader]}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="{Binding Loc[AppTitle]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <!-- Form Fields -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Loc[LoginPromptSelectUserLabel]}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbUsers" DisplayMemberPath="LocalizedUsername" Style="{StaticResource ModernComboBox}"
                              Height="42" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,10"
                              SelectionChanged="CmbUsers_SelectionChanged"/>

                    <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,14">
                        <TextBlock x:Name="TxtRoleInfo" Foreground="#0369A1" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="{Binding Loc[LoginPromptPasswordLabel]}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PwdBox" Height="42" FontSize="15" Padding="12,6"
                                 VerticalContentAlignment="Center" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5"
                                 KeyDown="PwdBox_KeyDown"/>

                    <TextBlock Text="{Binding Loc[LoginPromptDefaultUserHint]}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <TextBlock x:Name="TxtError" Text="{Binding Loc[LoginPromptError]}"
                               Foreground="#DC2626" FontWeight="Bold" FontSize="12.5" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Action Buttons -->
                <UniformGrid Grid.Row="2" Rows="1" Columns="2" Margin="0,18,0,0">
                    <Button Style="{StaticResource ModernPrimaryButton}" MinHeight="44" Margin="0,0,6,0" HorizontalAlignment="Stretch" Click="BtnLogin_Click">
                        <Viewbox StretchDirection="DownOnly">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource SecurityLockImage}" Width="20" Height="20" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Loc[LoginPromptLoginBtn]}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ModernSecondaryButton}" MinHeight="44" Margin="6,0,0,0" HorizontalAlignment="Stretch" Click="BtnCancel_Click">
                        <Viewbox StretchDirection="DownOnly">
                            <TextBlock Text="{Binding Loc[LoginPromptCancelBtn]}"/>
                        </Viewbox>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>