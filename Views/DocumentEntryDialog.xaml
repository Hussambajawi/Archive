<Window x:Class="DocuArchivePro.Views.DocumentEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DocuArchivePro.Models"
        Title="{Binding DialogTitle}" 
        Height="780" Width="1020"
        MinHeight="580" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/Icons/AppIcon.png"
        ResizeMode="CanResizeWithGrip"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Background="{DynamicResource AppBackgroundBrush}"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Loc[DocEntrySubtitle]}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Document Type Selector (Inbound / Outbound) -->
                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="8" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{Binding Loc[Inbound]}" IsChecked="{Binding IsInbound, Mode=TwoWay}" 
                                     GroupName="DocTypeGroup" Margin="8,4" FontWeight="SemiBold" IsThreeState="False"/>
                        <RadioButton Content="{Binding Loc[Outbound]}" IsChecked="{Binding IsOutbound, Mode=TwoWay}"
                                     GroupName="DocTypeGroup" Margin="8,4" FontWeight="SemiBold" IsThreeState="False"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content Body (2 Columns) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Core Fields -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <!-- Registration No. & Date Row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Loc[RegistrationNumber]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding RegistrationNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Loc[RegistrationDate]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding RegistrationDate}" Height="38"/>
                            </StackPanel>
                        </Grid>

                        <!-- Subject -->
                        <TextBlock Text="{Binding Loc[Subject]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MinHeight="40" Margin="0,0,0,16"/>

                        <!-- Sender & Recipient Row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Loc[Sender]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding SavedEntityNames}"
                                          SelectedItem="{Binding SelectedSenderEntityName, Mode=TwoWay}"
                                          Text="{Binding Sender, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="{Binding CanManualEntityEntry, Mode=OneWay}"
                                          IsTextSearchEnabled="True"
                                          Style="{StaticResource ModernComboBox}"
                                          ToolTip="{Binding Loc[EntityFieldTooltip]}"/>
                                <Button Command="{Binding AddSenderEntityCommand}"
                                        Style="{StaticResource ModernSecondaryButton}"
                                        Padding="8,2" FontSize="11" MinHeight="28" Height="28" Margin="0,6,0,0"
                                        ToolTip="{Binding Loc[AddSavedEntityTooltip]}">
                                    <Viewbox StretchDirection="DownOnly">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource SecurityLockImage}" Width="14" Height="14" Margin="0,0,4,0"
                                                   Visibility="{Binding EntityLockIconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Loc[AddSavedEntityBtnShort]}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Viewbox>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Loc[Recipient]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding SavedEntityNames}"
                                          SelectedItem="{Binding SelectedRecipientEntityName, Mode=TwoWay}"
                                          Text="{Binding Recipient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="{Binding CanManualEntityEntry, Mode=OneWay}"
                                          IsTextSearchEnabled="True"
                                          Style="{StaticResource ModernComboBox}"
                                          ToolTip="{Binding Loc[EntityFieldTooltip]}"/>
                                <Button Command="{Binding AddRecipientEntityCommand}"
                                        Style="{StaticResource ModernSecondaryButton}"
                                        Padding="8,2" FontSize="11" MinHeight="28" Height="28" Margin="0,6,0,0"
                                        ToolTip="{Binding Loc[AddSavedEntityTooltip]}">
                                    <Viewbox StretchDirection="DownOnly">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{StaticResource SecurityLockImage}" Width="14" Height="14" Margin="0,0,4,0"
                                                   Visibility="{Binding EntityLockIconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Loc[AddSavedEntityBtnShort]}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Category & Department -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Loc[Category]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding Categories}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" 
                                          SelectedValue="{Binding CategoryId}" Style="{StaticResource ModernComboBox}"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding EditSelectedCategoryCommand}" 
                                            Style="{StaticResource ModernSecondaryButton}" Padding="8,2" FontSize="11" MinHeight="28" Height="28"
                                            ToolTip="{Binding Loc[EditCategoryTooltip]}">
                                        <Viewbox StretchDirection="DownOnly">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource SecurityLockImage}" Width="14" Height="14" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Loc[EditCategoryBtnShort]}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Viewbox>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding AddNewCategoryCommand}" 
                                            Style="{StaticResource ModernSecondaryButton}" Padding="8,2" FontSize="11" MinHeight="28" Height="28"
                                            ToolTip="{Binding Loc[AddCategoryTooltip]}">
                                        <Viewbox StretchDirection="DownOnly">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource SecurityLockImage}" Width="14" Height="14" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Loc[AddCategoryBtnShort]}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Loc[Department]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Priority & Status -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Loc[Priority]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox SelectedIndex="{Binding PriorityIndex, Mode=TwoWay}" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="{Binding Loc[PriorityNormal]}"/>
                                    <ComboBoxItem Content="{Binding Loc[PriorityUrgent]}"/>
                                    <ComboBoxItem Content="{Binding Loc[PriorityVeryUrgent]}"/>
                                    <ComboBoxItem Content="{Binding Loc[PriorityConfidential]}"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Loc[Status]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox SelectedIndex="{Binding StatusIndex, Mode=TwoWay}" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="{Binding Loc[StatusNew]}"/>
                                    <ComboBoxItem Content="{Binding Loc[StatusInProgress]}"/>
                                    <ComboBoxItem Content="{Binding Loc[StatusCompleted]}"/>
                                    <ComboBoxItem Content="{Binding Loc[StatusArchived]}"/>
                                    <ComboBoxItem Content="{Binding Loc[StatusCancelled]}"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- External Reference & Delivery Method -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Loc[ExternalRef]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ExternalReferenceNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Loc[DeliveryMethod]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding DeliveryMethod, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Document Date, Follow-up Date & Tags -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Loc[DocumentDate]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding DocumentDate}" Height="38"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Loc[FollowUpDate]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <DatePicker SelectedDate="{Binding FollowUpDate}" Height="38"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tags & Linked Registration Number -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Loc[Tags]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Loc[RelatedRegNumberLabel]}" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <ComboBox ItemsSource="{Binding ExistingRegistrationNumbers}"
                                          Text="{Binding RelatedRegistrationNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" IsTextSearchEnabled="True"
                                          Style="{StaticResource ModernComboBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Notes -->
                        <TextBlock Text="{Binding Loc[Notes]}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" 
                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- Right Column: Attachments & Scanner Station -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding Loc[Attachments]}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                        <!-- Action Buttons: Upload & Scan + Drag & Drop Area -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Loc[DocEntryDragDropHint]}"
                                           Foreground="#1E40AF" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                            <Button Command="{Binding BrowseFileCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,0,8">
                                <Viewbox StretchDirection="DownOnly">
                                    <TextBlock Text="{Binding Loc[UploadFile]}"/>
                                </Viewbox>
                            </Button>
                            <Button Command="{Binding ScanFileCommand}" Style="{StaticResource ModernPrimaryButton}">
                                <Viewbox StretchDirection="DownOnly">
                                    <TextBlock Text="{Binding Loc[StartScan]}"/>
                                </Viewbox>
                            </Button>
                        </StackPanel>

                        <!-- Files List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Pending Attachments -->
                                <ItemsControl ItemsSource="{Binding PendingFilePaths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" CornerRadius="6" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5"/>
                                                    <Button Grid.Column="1" Content="👁" Width="28" Height="28" Margin="4,0"
                                                            Command="{Binding DataContext.PreviewPendingFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="{Binding DataContext.Loc[OpenFileTooltip], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ModernSecondaryButton}"/>
                                                    <Button Grid.Column="2" Content="✕" Width="26" Height="26" 
                                                            Command="{Binding DataContext.RemovePendingFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="Red" Cursor="Hand"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Existing Stored Attachments (In Edit Mode) -->
                                <ItemsControl ItemsSource="{Binding ExistingAttachments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F0FDF4" CornerRadius="6" BorderBrush="#BBF7D0" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                                        <TextBlock Text="{Binding FileSizeFormatted}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="👁" Width="28" Height="28" Margin="4,0"
                                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="{Binding DataContext.Loc[OpenFileTooltip], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ModernSecondaryButton}"/>
                                                    <Button Grid.Column="2" Width="28" Height="28"
                                                            Command="{Binding DataContext.DeleteExistingAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="{Binding DataContext.Loc[Delete], RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent" BorderThickness="0">
                                                        <Image Source="{StaticResource SecurityLockImage}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Footer (Elastic Buttons) -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="2" Margin="0,16,0,0">
            <Button Content="{Binding Loc[Save]}" Command="{Binding SaveCommand}" Style="{StaticResource ModernPrimaryButton}" MinHeight="44" Margin="0,0,8,0"/>
            <Button Content="{Binding Loc[Cancel]}" Command="{Binding CancelCommand}" Style="{StaticResource ModernSecondaryButton}" MinHeight="44" Margin="8,0,0,0"/>
        </UniformGrid>
    </Grid>
</Window>
