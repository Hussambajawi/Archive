<Window x:Class="DocuArchivePro.Views.ScannerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[ScannerWindowTitle]}" 
        Height="740" Width="1000"
        MinHeight="560" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/Icons/AppIcon.png"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Loc[ScannerHeaderTitle]}" FontSize="18" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtDefaultScannerInfo" FontSize="12.5" Foreground="#38BDF8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource ModernSecondaryButton}" Click="BtnRefreshScanners_Click">
                    <Viewbox StretchDirection="DownOnly">
                        <TextBlock Text="{Binding Loc[ScannerRefreshBtn]}"/>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Scanner Selection & Settings Panel -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Effect="{StaticResource CardShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[ScannerStep1Label]}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap"/>

                        <ListBox x:Name="LstScanners" ItemsSource="{Binding AvailableScanners}" SelectedItem="{Binding SelectedScanner, Mode=TwoWay}"
                                 Height="145" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,5">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding Loc[ScannerStep2Label]}" FontWeight="Bold" FontSize="14" Margin="0,4,0,10" Foreground="{DynamicResource PrimaryBrush}" TextWrapping="Wrap"/>

                        <TextBlock Text="{Binding Loc[ColorMode]}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                        <ComboBox SelectedIndex="0" x:Name="CmbColorMode" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                            <ComboBoxItem Content="{Binding Loc[Color]}" Tag="1"/>
                            <ComboBoxItem Content="{Binding Loc[Grayscale]}" Tag="2"/>
                            <ComboBoxItem Content="{Binding Loc[BlackWhite]}" Tag="4"/>
                        </ComboBox>

                        <TextBlock Text="{Binding Loc[Resolution]}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                        <ComboBox SelectedIndex="1" x:Name="CmbDpi" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                            <ComboBoxItem Content="{Binding Loc[Dpi150]}"/>
                            <ComboBoxItem Content="{Binding Loc[Dpi300]}"/>
                            <ComboBoxItem Content="{Binding Loc[Dpi600]}"/>
                        </ComboBox>

                        <CheckBox x:Name="ChkUseFeeder" Content="{Binding Loc[ScannerUseAdfCheck]}" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <Button Style="{StaticResource ModernSecondaryButton}" MinHeight="40" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"
                                Click="BtnSaveDefaultScanner_Click">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[ScannerSaveDefaultBtn]}"/>
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource ModernPrimaryButton}" MinHeight="46" Click="BtnScan_Click">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[ScannerExecuteBtn]}"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Preview Panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Border Background="#F1F5F9" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image x:Name="ImgPreview" Stretch="Uniform" Margin="10"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="TxtPlaceholder" Text="{Binding Loc[ScannerPlaceholder]}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" FontSize="14.5" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer (Elastic Buttons) -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="2" Margin="0,16,0,0">
            <Button Style="{StaticResource ModernPrimaryButton}" MinHeight="44" Margin="0,0,8,0" x:Name="BtnAccept" IsEnabled="False" Click="BtnAccept_Click">
                <Viewbox StretchDirection="DownOnly">
                    <TextBlock Text="{Binding Loc[ScannerAcceptBtn]}"/>
                </Viewbox>
            </Button>
            <Button Style="{StaticResource ModernSecondaryButton}" MinHeight="44" Margin="8,0,0,0" Click="BtnCancel_Click">
                <Viewbox StretchDirection="DownOnly">
                    <TextBlock Text="{Binding Loc[Cancel]}"/>
                </Viewbox>
            </Button>
        </UniformGrid>
    </Grid>
</Window>