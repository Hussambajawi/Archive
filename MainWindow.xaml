                            <Separator Margin="0,0,0,18"/>

                            <!-- Full System Backup & Scheduled Auto-Backup Section -->
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[FullBackupSectionTitle]}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
