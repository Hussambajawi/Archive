<Window x:Class="DocuArchivePro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DocuArchivePro.Models"
        Title="{Binding Loc[AppTitle]}" 
        Height="860" Width="1380"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Icons/AppIcon.png"
        ResizeMode="CanResizeWithGrip"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        Background="{DynamicResource AppBackgroundBrush}"
        FlowDirection="{Binding Loc.CurrentFlowDirection}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewInboundCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="N" Command="{Binding NewOutboundCommand}"/>
        <KeyBinding Modifiers="Control" Key="P" Command="{Binding OpenPrintCenterCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding FocusSearchCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- Global Dynamic Scale Transform so the user can also scale buttons & UI at will -->
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
        </Grid.LayoutTransform>

        <Grid.ColumnDefinitions>
            <!-- Proportional & Resizable Sidebar Navigation -->
            <ColumnDefinition Width="1.15*" MinWidth="210" MaxWidth="390"/>
            <ColumnDefinition Width="5"/>
            <!-- Proportional Main Content Area -->
            <ColumnDefinition Width="4.4*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR (ELASTIC BUTTONS) ================= -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Branding Header -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="14,12" Margin="12,14,12,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10">
                            <Image Source="{StaticResource AppLogoImage}" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Loc[AppBranding]}" FontWeight="Bold" FontSize="15.5" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Loc[AppAuthor]}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Elastic Navigation Menu Buttons (Grow & Shrink with Window Height & Sidebar Width) -->
                <UniformGrid Grid.Row="1" Columns="1" Margin="10,2">
                    <!-- 1. Dashboard -->
                    <Button Style="{StaticResource SidebarNavButton}" Margin="0,3"
                            Command="{Binding NavigateTabCommand}" CommandParameter="Dashboard">
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDashboard}" Fill="#38BDF8" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="{Binding Loc[Dashboard]}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>

                    <!-- 2. Inbound Archive -->
                    <Button Style="{StaticResource SidebarNavButton}" Margin="0,3"
                            Command="{Binding NavigateTabCommand}" CommandParameter="Inbound">
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconInbound}" Fill="#38BDF8" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="{Binding Loc[InboundArchive]}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>

                    <!-- 3. Outbound Archive -->
                    <Button Style="{StaticResource SidebarNavButton}" Margin="0,3"
                            Command="{Binding NavigateTabCommand}" CommandParameter="Outbound">
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconOutbound}" Fill="#34D399" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="{Binding Loc[OutboundArchive]}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>

                    <!-- 4. All Documents -->
                    <Button Style="{StaticResource SidebarNavButton}" Margin="0,3"
                            Command="{Binding NavigateTabCommand}" CommandParameter="All">
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconAllDocs}" Fill="#FBBF24" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="{Binding Loc[AllDocuments]}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>

                    <!-- 5. Scanner Selection & Station -->
                    <Button Style="{StaticResource SidebarNavButton}" Margin="0,3"
                            Command="{Binding QuickScanCommand}">
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconScanner}" Fill="#A78BFA" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="{Binding Loc[ScannerNav]}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>

                    <!-- 6. Encrypted Vault & Storage Location -->
                    <Button Style="{StaticResource SidebarNavButton}" Margin="0,3"
                            Command="{Binding OpenVaultCommand}">
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconAttachment}" Fill="#34D399" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="{Binding Loc[VaultNav]}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>

                    <!-- 7. Printing & Reports Center -->
                    <Button Style="{StaticResource SidebarNavButton}" Margin="0,3"
                            Command="{Binding OpenPrintCenterCommand}">
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconAllDocs}" Fill="#F472B6" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="{Binding Loc[PrintNav]}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>

                    <!-- 8. Date, Time, Gregorian & Hijri Calendar -->
                    <Button Style="{StaticResource SidebarNavButton}" Margin="0,3"
                            Command="{Binding OpenCalendarDialogCommand}">
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🕒" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Loc[CalendarNav]}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>

                    <!-- 9. Users, Passwords & Security PIN -->
                    <Button Style="{StaticResource SidebarNavButton}" Margin="0,3"
                            Command="{Binding OpenUserManagementCommand}">
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{StaticResource SecurityLockImage}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Loc[UsersNav]}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>

                    <!-- 10. Recycle Bin -->
                    <Button Style="{StaticResource SidebarNavButton}" Margin="0,3"
                            Command="{Binding NavigateTabCommand}" CommandParameter="RecycleBin">
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🗑️" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Loc[RecycleBinNav]}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>

                    <!-- 11. Settings -->
                    <Button Style="{StaticResource SidebarNavButton}" Margin="0,3"
                            Command="{Binding NavigateTabCommand}" CommandParameter="Settings">
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSettings}" Fill="#94A3B8" Width="18" Height="18" Stretch="Uniform"/>
                                <TextBlock Text="{Binding Loc[Settings]}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>

                    <!-- 11. About This Program (V1.1) -->
                    <Button Style="{StaticResource SidebarNavButton}" Margin="0,3"
                            Command="{Binding OpenAboutDialogCommand}">
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ℹ️" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Loc[AboutNav]}" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>
                </UniformGrid>

                <!-- Sidebar Footer Theme Toggle & Language Selector -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="10" Padding="12,10" Margin="10,8,10,12">
                    <StackPanel>
                        <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource SidebarNavButton}"
                                Background="{DynamicResource SecondaryButtonBgBrush}" BorderBrush="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                MinHeight="34" Height="34" Margin="0,0,0,10" HorizontalContentAlignment="Center" Padding="10,2">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc.ThemeButtonLabel}" FontWeight="Bold" FontSize="12.5"/>
                            </Viewbox>
                        </Button>
                        <TextBlock Text="{Binding Loc[CurrentLanguage]}" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Loc.SupportedLanguages}" 
                                  SelectedItem="{Binding Loc.CurrentLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="NativeName"
                                  Style="{StaticResource ModernComboBox}" Height="34" FontSize="12.5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Resizable Splitter between Sidebar and Main Content -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CBD5E1" Cursor="SizeWE"/>

        <!-- ================= MAIN CONTENT (PROPORTIONAL & ELASTIC) ================= -->
        <Grid Grid.Column="2" Margin="16,14">
            <Grid.RowDefinitions>
                <!-- Row 0: Live Date, Time, Gregorian & Hijri + UI Scale Controls -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Elastic System Action Buttons & Search Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Dynamic Content View (Expands to Fill Screen) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0. MODERN LIVE TIME, DAY, GREGORIAN & HIJRI DATE + ELASTIC HEADER BUTTONS -->
            <Border Grid.Row="0" CornerRadius="12" Padding="14,10" Margin="0,0,0,12" Effect="{StaticResource CardShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#1E3A8A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.95*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.75*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Clock & Day + Dates + App Logo -->
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,2,10,2" VerticalAlignment="Center">
                            <Image Source="{StaticResource AppLogoImage}" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,2,10,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕒 " FontSize="13.5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LiveDayText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="|" Foreground="#475569" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LiveClockText}" Foreground="White" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel VerticalAlignment="Center" Margin="0,2">
                            <WrapPanel>
                                <TextBlock Text="{Binding Loc[GregorianLabel]}" Foreground="#94A3B8" FontSize="12"/>
                                <TextBlock Text="{Binding LiveGregorianText}" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Loc[HijriLabel]}" Foreground="#34D399" FontSize="12"/>
                                <TextBlock Text="{Binding LiveHijriText}" Foreground="#34D399" FontWeight="Bold" FontSize="12"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,3,0,0">
                                <TextBlock Text="{Binding Loc[CurrentUserLabel]}" Foreground="#93C5FD" FontSize="11.5"/>
                                <TextBlock Text="{Binding CurrentUserSummary}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11.5"/>
                            </WrapPanel>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Elastic Header Controls: UI Scale (+/-) + Calendar + Users -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row A: Elastic Quick Buttons (Theme Toggle + Calendar + Users) -->
                        <UniformGrid Grid.Row="0" Rows="1" Columns="3">
                            <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource ModernSecondaryButton}"
                                    Background="{DynamicResource SecondaryButtonBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="Bold" Padding="8,5" Margin="3,0">
                                <Viewbox StretchDirection="DownOnly">
                                    <TextBlock Text="{Binding Loc.ThemeButtonLabel}"/>
                                </Viewbox>
                            </Button>
                            <Button Command="{Binding OpenCalendarDialogCommand}" Style="{StaticResource ModernSecondaryButton}" FontSize="12" Padding="8,5" Margin="3,0">
                                <Viewbox StretchDirection="DownOnly">
                                    <TextBlock Text="{Binding Loc[CalendarBtn]}"/>
                                </Viewbox>
                            </Button>
                            <Button Command="{Binding OpenUserManagementCommand}" Style="{StaticResource ModernSecondaryButton}" FontSize="12" Padding="8,5" Margin="3,0">
                                <Viewbox StretchDirection="DownOnly">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="{StaticResource SecurityLockImage}" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Loc[UsersBtn]}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Viewbox>
                            </Button>
                        </UniformGrid>

                        <!-- Row B: Elastic UI & Buttons Zoom Control Bar -->
                        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="6,4" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Loc[UiScaleLabel]}" Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,8,0"/>
                                <Button Grid.Column="1" Command="{Binding ZoomInUiCommand}" Style="{StaticResource ModernPrimaryButton}" MinHeight="28" Padding="6,2" FontSize="11.5" Margin="2,0">
                                    <Viewbox StretchDirection="DownOnly">
                                        <TextBlock Text="{Binding Loc[ZoomIn]}"/>
                                    </Viewbox>
                                </Button>
                                <Button Grid.Column="2" Content="{Binding UiScalePercentText}" Command="{Binding ResetUiZoomCommand}" Style="{StaticResource ModernSecondaryButton}" MinHeight="28" Padding="6,2" FontSize="11.5" Margin="2,0" ToolTip="{Binding Loc[ResetZoomTooltip]}"/>
                                <Button Grid.Column="3" Command="{Binding ZoomOutUiCommand}" Style="{StaticResource ModernSecondaryButton}" MinHeight="28" Padding="6,2" FontSize="11.5" Margin="2,0">
                                    <Viewbox StretchDirection="DownOnly">
                                        <TextBlock Text="{Binding Loc[ZoomOut]}"/>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 1. ELASTIC SYSTEM ACTION BUTTONS & SEARCH BAR (Grow & Shrink with Window Width) -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="12,10" Margin="0,0,0,12" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Search Box Column (Proportional) -->
                        <ColumnDefinition Width="1.15*" MinWidth="180"/>
                        <ColumnDefinition Width="12"/>
                        <!-- 5 Primary System Buttons Column (Proportional Elastic UniformGrid) -->
                        <ColumnDefinition Width="2.4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Box -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5" CornerRadius="10" Padding="10,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="4,0,8,0"/>
                            <TextBox x:Name="TxtSearchBox" Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" FontSize="13.5" VerticalContentAlignment="Center" Background="Transparent"
                                     ToolTip="{Binding Loc[SearchPlaceholder]}"/>
                        </Grid>
                    </Border>

                    <!-- 5 Elastic System Action Buttons (Stretch & Shrink Automatically) -->
                    <UniformGrid Grid.Column="2" Rows="1" Columns="5">
                        <Button Command="{Binding NewDocumentCommand}" Style="{StaticResource ModernPrimaryButton}" Margin="3,0" MinHeight="42">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[NewDocumentBtn]}" FontWeight="Bold" FontSize="13.5"/>
                            </Viewbox>
                        </Button>
                        <Button Command="{Binding QuickScanCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="3,0" MinHeight="42" BorderBrush="#A78BFA" Foreground="#5B21B6">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[ScanBtn]}" FontWeight="SemiBold" FontSize="13.5"/>
                            </Viewbox>
                        </Button>
                        <Button Command="{Binding OpenVaultCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="3,0" MinHeight="42" BorderBrush="#34D399" Foreground="#065F46">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[VaultBtn]}" FontWeight="SemiBold" FontSize="13.5"/>
                            </Viewbox>
                        </Button>
                        <Button Command="{Binding OpenPrintCenterCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="3,0" MinHeight="42" BorderBrush="#93C5FD" Foreground="#1E40AF">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[PrintBtn]}" FontWeight="SemiBold" FontSize="13.5"/>
                            </Viewbox>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="3,0" MinHeight="42">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Loc[RefreshBtn]}" FontWeight="SemiBold" FontSize="13.5"/>
                            </Viewbox>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- ================= VIEW CONTAINER ================= -->
            <Grid Grid.Row="2">
                <!-- 1. DASHBOARD & DOCUMENTS VIEW (Fluid Resizable Grid) -->
                <Grid Visibility="{Binding IsDocumentsViewVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 7 Modern Elastic Statistical Labels + Follow-Up Due Alert Banner -->
                    <StackPanel Grid.Row="0" Visibility="{Binding IsDashboardTab, Converter={StaticResource BoolToVis}}">
                    <UniformGrid Rows="1" Columns="7" Margin="0,0,0,12">
                        <!-- Label 1: Total Archive -->
                        <Border Background="White" CornerRadius="12" Padding="12,10" Margin="0,0,4,0" Effect="{StaticResource CardShadow}" BorderBrush="#BFDBFE" BorderThickness="1">
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[TotalDocsLabel]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Stats.TotalDocuments, Converter={StaticResource LocValConverter}}" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Viewbox>
                        </Border>

                        <!-- Label 2: Encrypted Files -->
                        <Border Background="White" CornerRadius="12" Padding="12,10" Margin="4,0" Effect="{StaticResource CardShadow}" BorderBrush="#A7F3D0" BorderThickness="1">
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[EncryptedFilesLabel]}" Foreground="#047857" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Stats.TotalAttachmentsCount, Converter={StaticResource LocValConverter}}" FontSize="23" FontWeight="Bold" Foreground="#059669" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Viewbox>
                        </Border>

                        <!-- Label 3: Inbound -->
                        <Border Background="White" CornerRadius="12" Padding="12,10" Margin="4,0" Effect="{StaticResource CardShadow}" BorderBrush="#BAE6FD" BorderThickness="1">
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[InboundDocsLabel]}" Foreground="#0284C7" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Stats.InboundCount, Converter={StaticResource LocValConverter}}" FontSize="23" FontWeight="Bold" Foreground="#0284C7" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Viewbox>
                        </Border>

                        <!-- Label 4: Outbound -->
                        <Border Background="White" CornerRadius="12" Padding="12,10" Margin="4,0" Effect="{StaticResource CardShadow}" BorderBrush="#A7F3D0" BorderThickness="1">
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[OutboundDocsLabel]}" Foreground="#059669" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Stats.OutboundCount, Converter={StaticResource LocValConverter}}" FontSize="23" FontWeight="Bold" Foreground="#059669" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Viewbox>
                        </Border>

                        <!-- Label 5: Urgent -->
                        <Border Background="White" CornerRadius="12" Padding="12,10" Margin="4,0" Effect="{StaticResource CardShadow}" BorderBrush="#FECACA" BorderThickness="1">
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[UrgentDocsLabel]}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Stats.UrgentCount, Converter={StaticResource LocValConverter}}" FontSize="23" FontWeight="Bold" Foreground="#DC2626" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Viewbox>
                        </Border>

                        <!-- Label 6: Today's Registrations -->
                        <Border Background="White" CornerRadius="12" Padding="12,10" Margin="4,0" Effect="{StaticResource CardShadow}" BorderBrush="#FDE68A" BorderThickness="1">
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[TodayDocsLabel]}" Foreground="#B45309" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Stats.TodayCount, Converter={StaticResource LocValConverter}}" FontSize="23" FontWeight="Bold" Foreground="#D97706" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Viewbox>
                        </Border>

                        <!-- Label 7: Follow-Up Due -->
                        <Border Background="White" CornerRadius="12" Padding="12,10" Margin="4,0,0,0" Effect="{StaticResource CardShadow}" BorderBrush="#DDD6FE" BorderThickness="1">
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[FollowUpDueLabel]}" Foreground="#6D28D9" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Stats.FollowUpDueCount, Converter={StaticResource LocValConverter}}" FontSize="23" FontWeight="Bold" Foreground="#6D28D9" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Viewbox>
                        </Border>
                    </UniformGrid>

                    <Border Visibility="{Binding HasFollowUpDue, Converter={StaticResource BoolToVis}}"
                            Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1.5" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FollowUpAlertBannerText}" Foreground="#92400E" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Command="{Binding FilterFollowUpDueCommand}" Style="{StaticResource ModernPrimaryButton}" MinHeight="32" Padding="12,4" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Loc[FollowUpFilterBtn]}" FontSize="12" FontWeight="Bold"/>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding FilterFollowUpDueCommand}" CommandParameter="Clear"
                                    Visibility="{Binding OnlyFollowUpDue, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource ModernSecondaryButton}" MinHeight="32" Padding="12,4" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Loc[FollowUpShowAllBtn]}" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>
                    </StackPanel>

                    <!-- Documents Table Card (Expands dynamically with Window Size) -->
                    <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Proportional Filter Bar -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding Loc[DocumentsTableTitle]}" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>

                                    <DockPanel Grid.Column="0" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Loc[FromDate]}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <DatePicker SelectedDate="{Binding FilterFromDate}" HorizontalAlignment="Stretch"/>
                                    </DockPanel>

                                    <DockPanel Grid.Column="1" Margin="4,0" VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Loc[ToDate]}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <DatePicker SelectedDate="{Binding FilterToDate}" HorizontalAlignment="Stretch"/>
                                    </DockPanel>

                                    <ComboBox Grid.Column="2" ItemsSource="{Binding FilterCategories}" SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                              SelectedValue="{Binding FilterCategoryId}" Margin="4,0" Style="{StaticResource ModernComboBox}" HorizontalAlignment="Stretch"/>

                                    <ComboBox Grid.Column="3" SelectedIndex="{Binding FilterPriorityIndex, Mode=TwoWay}" Margin="4,0" Style="{StaticResource ModernComboBox}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="{Binding Loc[AllPriorities]}"/>
                                        <ComboBoxItem Content="{Binding Loc[PriorityNormal]}"/>
                                        <ComboBoxItem Content="{Binding Loc[PriorityUrgent]}"/>
                                        <ComboBoxItem Content="{Binding Loc[PriorityVeryUrgent]}"/>
                                        <ComboBoxItem Content="{Binding Loc[PriorityConfidential]}"/>
                                    </ComboBox>

                                    <ComboBox Grid.Column="4" SelectedIndex="{Binding FilterStatusIndex, Mode=TwoWay}" Margin="4,0" Style="{StaticResource ModernComboBox}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="{Binding Loc[AllStatuses]}"/>
                                        <ComboBoxItem Content="{Binding Loc[StatusNew]}"/>
                                        <ComboBoxItem Content="{Binding Loc[StatusInProgress]}"/>
                                        <ComboBoxItem Content="{Binding Loc[StatusCompleted]}"/>
                                        <ComboBoxItem Content="{Binding Loc[StatusArchived]}"/>
                                        <ComboBoxItem Content="{Binding Loc[StatusCancelled]}"/>
                                    </ComboBox>

                                    <Button Grid.Column="5" Command="{Binding ResetFiltersCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="4,0,0,0">
                                        <Viewbox StretchDirection="DownOnly">
                                            <TextBlock Text="{Binding Loc[ResetFilters]}"/>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- Documents DataGrid (All columns localized dynamically & convert numbers/enums) -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}"
                                      Style="{StaticResource ModernDataGrid}"
                                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                                <DataGrid.ContextMenu>
                                    <ContextMenu FontFamily="{DynamicResource AppFontFamily}">
                                        <MenuItem Header="{Binding Loc[PreviewAttachment]}" Command="{Binding PreviewSelectedAttachmentCommand}" FontWeight="Bold"/>
                                        <MenuItem Header="✅ تحديد المعاملة كمنجزة (إغلاق المتابعة) / Mark as Completed" Command="{Binding MarkSelectedAsCompletedCommand}"/>
                                        <MenuItem Header="🔗 الانتقال إلى المعاملة المرتبطة / Jump to Linked Document"
                                                  Command="{Binding OpenRelatedDocumentCommand}"
                                                  CommandParameter="{Binding SelectedDocument.RelatedRegistrationNumber}"/>
                                        <Separator/>
                                        <MenuItem Header="{Binding Loc[PrintDocument]}" Command="{Binding PrintSelectedDocumentCommand}"/>
                                        <MenuItem Header="{Binding Loc[EditDocument]}" Command="{Binding EditDocumentCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="{Binding Loc[DeleteDocument]}" Command="{Binding DeleteDocumentCommand}" Foreground="#DC2626"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="1.1*">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DataContext.Loc[ColRegNumber], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RegistrationNumber, Converter={StaticResource LocValConverter}}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="0.9*">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DataContext.Loc[ColRelatedReg], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.OpenRelatedDocumentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding RelatedRegistrationNumber}"
                                                        Cursor="Hand"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="2,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelatedRegistrationNumber}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding RelatedRegistrationNumber}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock Text="{Binding RelatedRegistrationNumber, Converter={StaticResource LocValConverter}}" 
                                                                       Foreground="#0284C7" FontWeight="SemiBold"
                                                                       TextDecorations="Underline" Cursor="Hand"
                                                                       ToolTip="انقر للانتقال المباشر إلى المعاملة المرتبطة / Click to jump to related document"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="0.7*">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DataContext.Loc[ColType], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Type, Converter={StaticResource LocValConverter}}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="0.95*">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DataContext.Loc[ColRegDate], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RegistrationDate, Converter={StaticResource LocValConverter}, ConverterParameter='yyyy-MM-dd'}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="2.1*">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DataContext.Loc[ColSubject], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Subject, Converter={StaticResource LocValConverter}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="1.2*">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DataContext.Loc[ColDossier], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Category.DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="1.25*">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DataContext.Loc[ColSender], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Sender, Converter={StaticResource LocValConverter}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="1.25*">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DataContext.Loc[ColRecipient], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Recipient, Converter={StaticResource LocValConverter}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="0.9*">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DataContext.Loc[ColAttachments], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Attachments.Count, Converter={StaticResource LocValConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Elastic Bottom Action Buttons Bar (4 Proportional Buttons across full width) -->
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <UniformGrid Grid.Row="0" Rows="1" Columns="5" Visibility="{Binding IsNormalDocsTab, Converter={StaticResource BoolToVis}}">
                                    <Button Command="{Binding PreviewSelectedAttachmentCommand}" Style="{StaticResource ModernPrimaryButton}" Margin="0,0,6,0" MinHeight="42">
                                        <Viewbox StretchDirection="DownOnly">
                                            <TextBlock Text="{Binding Loc[PreviewAttachment]}" FontWeight="Bold" FontSize="13.5"/>
                                        </Viewbox>
                                    </Button>

                                    <Button Command="{Binding MarkSelectedAsCompletedCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="3,0" MinHeight="42" BorderBrush="#86EFAC" Foreground="#15803D">
                                        <Viewbox StretchDirection="DownOnly">
                                            <TextBlock Text="✅ تحديد كمنجزة / Completed" FontWeight="SemiBold" FontSize="13.5"/>
                                        </Viewbox>
                                    </Button>

                                    <Button Command="{Binding PrintSelectedDocumentCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="3,0" MinHeight="42" BorderBrush="#93C5FD" Foreground="#1E40AF">
                                        <Viewbox StretchDirection="DownOnly">
                                            <TextBlock Text="{Binding Loc[PrintDocument]}" FontWeight="SemiBold" FontSize="13.5"/>
                                        </Viewbox>
                                    </Button>

                                    <Button Command="{Binding EditDocumentCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="3,0" MinHeight="42" BorderBrush="#FCD34D" Foreground="#92400E">
                                        <Viewbox StretchDirection="DownOnly">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource SecurityLockImage}" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Loc[EditDocument]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Viewbox>
                                    </Button>

                                    <Button Command="{Binding DeleteDocumentCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="6,0,0,0" MinHeight="42" BorderBrush="#FCA5A5" Foreground="#DC2626">
                                        <Viewbox StretchDirection="DownOnly">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource SecurityLockImage}" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Loc[DeleteDocument]}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Viewbox>
                                    </Button>
                                </UniformGrid>

                                <UniformGrid Grid.Row="0" Rows="1" Columns="3" Visibility="{Binding IsRecycleBinTab, Converter={StaticResource BoolToVis}}">
                                    <Button Command="{Binding RestoreSelectedDocumentCommand}" Style="{StaticResource ModernPrimaryButton}" Margin="0,0,6,0" MinHeight="42">
                                        <Viewbox StretchDirection="DownOnly">
                                            <TextBlock Text="{Binding Loc[RestoreDocumentBtn]}" FontWeight="Bold" FontSize="13.5"/>
                                        </Viewbox>
                                    </Button>

                                    <Button Command="{Binding DeleteDocumentCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="3,0" MinHeight="42" BorderBrush="#FCA5A5" Foreground="#DC2626">
                                        <Viewbox StretchDirection="DownOnly">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource SecurityLockImage}" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Loc[PermanentDeleteBtn]}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Viewbox>
                                    </Button>

                                    <Button Command="{Binding EmptyRecycleBinCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="6,0,0,0" MinHeight="42" BorderBrush="#F87171" Foreground="#B91C1C">
                                        <Viewbox StretchDirection="DownOnly">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{StaticResource SecurityLockImage}" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Loc[EmptyRecycleBinBtn]}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Viewbox>
                                    </Button>
                                </UniformGrid>

                                <TextBlock Grid.Row="1" Text="{Binding Loc[DragDropTip]}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. SETTINGS VIEW (Elastic Proportional Buttons & Localized) -->
                <Border Background="White" CornerRadius="12" Padding="24" Effect="{StaticResource CardShadow}"
                        Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[SettingsTitle]}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <!-- Users, Passwords & Security PIN Section inside Settings -->
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[UsersSecuritySection]}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Loc[DefaultUserInfo]}"
                                               FontWeight="SemiBold" Foreground="#0F172A" FontSize="13.5" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Loc[UsersSecurityDesc]}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <UniformGrid Columns="2">
                                        <Button Command="{Binding OpenUserManagementCommand}" Style="{StaticResource ModernPrimaryButton}" Margin="4" MinHeight="44">
                                            <Viewbox StretchDirection="DownOnly">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="{StaticResource SecurityLockImage}" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding Loc[OpenUsersBtn]}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Viewbox>
                                        </Button>
                                        <Button Command="{Binding OpenVaultCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="4" MinHeight="44">
                                            <Viewbox StretchDirection="DownOnly">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Image Source="{StaticResource SecurityLockImage}" Width="18" Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding Loc[OpenVaultBtn]}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Viewbox>
                                        </Button>
                                        <Button Command="{Binding QuickScanCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="4" MinHeight="44">
                                            <Viewbox StretchDirection="DownOnly">
                                                <TextBlock Text="{Binding Loc[ChooseScannerBtn]}"/>
                                            </Viewbox>
                                        </Button>
                                        <Button Command="{Binding OpenPrintCenterCommand}" Style="{StaticResource ModernSecondaryButton}" Margin="4" MinHeight="44">
                                            <Viewbox StretchDirection="DownOnly">
                                                <TextBlock Text="{Binding Loc[PrintCenterBtn]}"/>
                                            </Viewbox>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Separator Margin="0,0,0,18"/>

                            <!-- Theme Settings Section (Day / Night Mode) -->
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Left" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Loc.CurrentThemeStatusText}" FontWeight="Bold" FontSize="12.5" Foreground="#1E40AF"/>
                                        </Border>
                                        <TextBlock Text="{Binding Loc[ThemeSettingsHeader]}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Loc[ThemeSettingsDesc]}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <UniformGrid Columns="2">
                                        <Button Command="{Binding SetThemeCommand}" CommandParameter="Light" Style="{StaticResource ModernSecondaryButton}" Margin="4" MinHeight="44">
                                            <Viewbox StretchDirection="DownOnly">
                                                <TextBlock Text="{Binding Loc[ThemeDayBtn]}" FontWeight="Bold"/>
                                            </Viewbox>
                                        </Button>
                                        <Button Command="{Binding SetThemeCommand}" CommandParameter="Dark" Style="{StaticResource ModernPrimaryButton}" Margin="4" MinHeight="44">
                                            <Viewbox StretchDirection="DownOnly">
                                                <TextBlock Text="{Binding Loc[ThemeNightBtn]}" FontWeight="Bold"/>
                                            </Viewbox>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Separator Margin="0,0,0,18"/>

                            <TextBlock Text="{Binding Loc[LanguageSettings]}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding Loc[LanguageDesc]}" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <UniformGrid Columns="2" Margin="0,0,0,18">
                                <Button Command="{Binding ChangeLanguageCommand}" CommandParameter="ar" Style="{StaticResource ModernPrimaryButton}" Margin="4" MinHeight="44">
                                    <Viewbox StretchDirection="DownOnly">
                                        <TextBlock Text="{Binding Loc[LangArabicBtn]}"/>
                                    </Viewbox>
                                </Button>
                                <Button Command="{Binding ChangeLanguageCommand}" CommandParameter="en" Style="{StaticResource ModernSecondaryButton}" Margin="4" MinHeight="44">
                                    <Viewbox StretchDirection="DownOnly">
                                        <TextBlock Text="{Binding Loc[LangEnglishBtn]}"/>
                                    </Viewbox>
                                </Button>
                            </UniformGrid>

                            <Separator Margin="0,0,0,18"/>

                            <!-- Font & Numbers Settings Section -->
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="{Binding Loc[FontSettingsHeader]}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Loc[FontSettingsDesc]}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Loc[SelectArabicFont]}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                            <ComboBox ItemsSource="{Binding AvailableArabicFonts}" SelectedItem="{Binding SelectedArabicFont, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName" Style="{StaticResource ModernComboBox}" Height="38"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Loc[FontPreviewLabel]}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                            <Border Background="White" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" Padding="14,9">
                                                <TextBlock Text="{Binding Loc[FontPreviewSample]}"
                                                           FontSize="14" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Separator Margin="0,0,0,18"/>

                            <!-- Dossiers & Categories Management Section -->
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Loc[DossiersSectionTitle]}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Loc[DossiersSectionDesc]}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding ImportCategoryBackupCommand}" 
                                                    Style="{StaticResource ModernSecondaryButton}" Padding="14,8" MinHeight="40" Margin="0,0,8,0">
                                                <Viewbox StretchDirection="DownOnly">
                                                    <TextBlock Text="{Binding Loc[ImportDossierBtn]}"/>
                                                </Viewbox>
                                            </Button>
                                            <Button Command="{Binding OpenAddCategoryCommand}" 
                                                    Style="{StaticResource ModernPrimaryButton}" Padding="16,8" MinHeight="40">
                                                <Viewbox StretchDirection="DownOnly">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{StaticResource SecurityLockImage}" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="{Binding Loc[AddDossierBtn]}" VerticalAlignment="Center"/>
                                                    </StackPanel>
